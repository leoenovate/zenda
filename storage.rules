rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    // Chat attachments uploaded from message_input.dart. Any authenticated
    // user can upload their own attachment, and any authenticated user can
    // read (so the other chat participant can display the image).
    match /chat_attachments/{studentId}/{fileName} {
      allow read:  if request.auth != null;
      allow write: if request.auth != null
                   && request.resource.size < 10 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }

    // Supporting documents for staff time-off (see staff_time_off_screen.dart).
    match /time_off_attachments/{schoolId}/{timeOffId}/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
                  && request.resource.size < 10 * 1024 * 1024
                  && (
                    request.resource.contentType.matches('image/.*')
                    || request.resource.contentType == 'application/pdf'
                    || request.resource.contentType == 'application/msword'
                    || request.resource.contentType
                        == 'application/vnd.openxmlformats-officedocument.wordprocessingml.document'
                    || request.resource.contentType
                        == 'application/vnd.openxmlformats-officedocument.spreadsheetml.sheet'
                    || request.resource.contentType == 'application/vnd.ms-excel'
                  );
    }

    // Deny everything else by default.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
