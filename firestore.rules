rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Firestore-only auth: the Flutter app authenticates against users docs
    // and enforces role/school scoping in the client service layer. Because no
    // server-verifiable identity is attached to requests, rules cannot inspect
    // per-user roles here.
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
